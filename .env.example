# 普通聊天和财报分析使用的 DeepSeek API Key。
# 留空也能打开页面，但调用模型时会失败。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 完整财报 RAG。启用时必须同时填写 Embedding API Key。
FINMATE_RAG_ENABLED=false
FINMATE_RAG_QDRANT_API_KEY=
FINMATE_RAG_COLLECTION=finmate_reports_v1
FINMATE_RAG_EMBEDDING_API_KEY=
FINMATE_RAG_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
FINMATE_RAG_EMBEDDING_MODEL=text-embedding-v4
FINMATE_RAG_DIMENSIONS=1024
FINMATE_RAG_MIN_SCORE=0.45

# 本地 Docker 数据库配置。以下值只是示例，首次使用时请自行修改。
MYSQL_DATABASE=finance_agent_db
MYSQL_USERNAME=finmate
MYSQL_PASSWORD=change_me_local
MYSQL_ROOT_PASSWORD=change_me_root_local
MONGODB_DATABASE=chat_memory_db
FINMATE_PORT=8080

# 仅在使用 compose.rag.yaml 单独启动 Qdrant 时使用。
FINMATE_RAG_QDRANT_PORT=6333
